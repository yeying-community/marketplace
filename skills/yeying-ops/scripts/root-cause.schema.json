{
  "type": "object",
  "required": [
    "summary",
    "severity",
    "root_cause",
    "confidence",
    "evidence",
    "impact",
    "alternative_hypotheses",
    "recommended_actions",
    "action_plan",
    "missing_information",
    "dedup_fingerprint",
    "occurrences",
    "first_seen",
    "last_seen"
  ],
  "properties": {
    "summary": {"type": "string", "maxLength": 240},
    "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
    "root_cause": {
      "type": "object",
      "required": ["category", "explanation"],
      "properties": {
        "category": {"type": "string", "enum": ["confirmed", "likely", "unknown"]},
        "explanation": {"type": "string"}
      },
      "additionalProperties": false
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "impact": {"type": "array", "items": {"type": "string"}},
    "alternative_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hypothesis", "supporting_evidence", "contradicting_evidence", "verification"],
        "properties": {
          "hypothesis": {"type": "string", "minLength": 1},
          "supporting_evidence": {"type": "array", "items": {"type": "string"}},
          "contradicting_evidence": {"type": "array", "items": {"type": "string"}},
          "verification": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "recommended_actions": {"type": "array", "items": {"type": "string"}},
    "action_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "expected", "risk", "undo"],
        "properties": {
          "action": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "risk": {"type": "string", "minLength": 1},
          "undo": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "missing_information": {"type": "array", "items": {"type": "string"}},
    "dedup_fingerprint": {"type": "string"},
    "occurrences": {"type": "integer", "minimum": 1},
    "first_seen": {"type": "string"},
    "last_seen": {"type": "string"}
  },
  "additionalProperties": false
}
